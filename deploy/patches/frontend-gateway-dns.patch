diff --git a/deploy/nginx.conf.template b/deploy/nginx.conf.template
index 23508ed..8d71059 100644
--- a/deploy/nginx.conf.template
+++ b/deploy/nginx.conf.template
@@ -19,6 +19,10 @@ server {
     server_tokens off;
     client_max_body_size 2m;
 
+    # Docker puede cambiar la IP del gateway al recrearlo. Resolverla en cada renovación de caché.
+    resolver 127.0.0.11 valid=10s;
+    set $gateway_upstream "${GATEWAY_URL}";
+
     gzip on;
     gzip_types text/css application/javascript application/json image/svg+xml;
     gzip_min_length 1024;
@@ -36,7 +40,7 @@ server {
 
     # WebSocket de cotizaciones de M4 (STOMP/SockJS) a través del gateway.
     location /api/v1/market/ws/ {
-        proxy_pass ${GATEWAY_URL};
+        proxy_pass $gateway_upstream$request_uri;
         proxy_http_version 1.1;
         proxy_set_header Upgrade $http_upgrade;
         proxy_set_header Connection $connection_upgrade;
@@ -49,7 +53,7 @@ server {
 
     # API REST del gateway (/api/v1/...). La ruta se reenvía completa.
     location /api/ {
-        proxy_pass ${GATEWAY_URL};
+        proxy_pass $gateway_upstream$request_uri;
