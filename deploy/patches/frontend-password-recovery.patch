+++ b/tests/passwordReset.test.mjs
@@ -0,0 +1,207 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { Gateway } from '../src/services/api.ts'
+import { consumePasswordResetFragment, parsePasswordResetFragment, passwordResetErrorKey, passwordResetIssue } from '../src/services/passwordReset.ts'
+
+test('recuperación envía los contratos públicos sin sesión y requiere login/MFA después', async t => {
+  const calls = []
+  const writes = []
+  const storage = { getItem: () => null, setItem: (...args) => writes.push(args), removeItem: () => {} }
+  const correo = 'recovery@example.test'
+  const password = '  Nueva clave 123  '
+  t.mock.method(globalThis, 'fetch', async (url, options) => {
+    const path = new URL(url).pathname
+    const body = JSON.parse(options.body)
+    calls.push({ path, body })
+    assert.equal(options.method, 'POST')
+    assert.equal(options.headers.has('Authorization'), false)
+    assert.equal(options.cache, 'no-store')
+    assert.ok(options.headers.get('X-Correlation-ID'))
+    if (path.endsWith('/password-reset/request')) return Response.json({ message: 'Respuesta genérica' }, { status: 202 })
+    if (path.endsWith('/password-reset/confirm')) return Response.json({ message: 'Actualizada' })
+    if (path.endsWith('/login')) return Response.json({ requiresMfa: true, userId: 42 })
+    if (path.endsWith('/mfa/verify')) return Response.json({ accessToken: 'fixture-access', refreshToken: 'fixture-refresh', user: { id: 42, correo } })
+    throw new Error('Ruta inesperada')
+  })
+  const api = new Gateway('https://gateway.test/api/v1', storage)
+
+  await api.requestPasswordReset(correo)
+  await api.confirmPasswordReset(correo, '012345', password)
+  assert.deepEqual(calls, [
+    { path: '/api/v1/auth/password-reset/request', body: { correo } },
+    { path: '/api/v1/auth/password-reset/confirm', body: { correo, code: '012345', newPassword: password } },
+  ])
+  assert.equal(api.snapshot(), null)
+  assert.deepEqual(writes, [])
+
+  const challenge = await api.login(correo, password)
+  assert.equal(api.snapshot(), null)
+  assert.deepEqual(writes, [])
+  await api.verify(challenge, '654321')
+  assert.equal(api.snapshot().user.id, 42)
+  assert.equal(writes.length, 1)
+  assert.equal(writes[0][1].includes(password), false)
+})
+
+test('código inválido/expirado permite corregirlo sin sesión ni persistir secretos', async t => {
+  let attempts = 0
+  const writes = []
+  const calls = []
+  t.mock.method(globalThis, 'fetch', async (_url, options) => {
+    calls.push(JSON.parse(options.body))
+    attempts++
+    return attempts === 1
+      ? Response.json({ error: 'No se pudo restablecer la contraseña.' }, { status: 401 })
+      : Response.json({ message: 'Actualizada' })
+  })
+  const api = new Gateway('https://gateway.test/api/v1', { getItem: () => null, setItem: (...args) => writes.push(args) })
+  await assert.rejects(api.confirmPasswordReset('recovery@example.test', '000000', 'Nueva clave 123'), error => error.status === 401)
+  await api.confirmPasswordReset('recovery@example.test', '012345', 'Nueva clave 123')
+  assert.equal(calls.length, 2)
+  assert.equal(calls[0].correo, calls[1].correo)
+  assert.equal(api.snapshot(), null)
+  assert.deepEqual(writes, [])
+})
+
+test('reenvío solo ocurre por una llamada explícita y nunca por reintento automático', async t => {
+  let count = 0
+  t.mock.method(globalThis, 'fetch', async () => {
+    count++
+    throw new TypeError('offline')
+  })
+  const api = new Gateway('https://gateway.test/api/v1')
+  await assert.rejects(api.requestPasswordReset('recovery@example.test'), error => error.status === 0)
+  assert.equal(count, 1)
+  await assert.rejects(api.requestPasswordReset('recovery@example.test'), error => error.status === 0)
+  assert.equal(count, 2)
+  assert.equal(api.snapshot(), null)
+})
+
+test('valida código6, confirmación exacta y mínimo8 puntos Unicode sin recortar la clave', () => {
+  assert.equal(passwordResetIssue('012345', '  clave  ', '  clave  '), null)
+  assert.equal(passwordResetIssue('012345', '        ', '        '), 'acc.reset.passwordBlank')
+  assert.equal(passwordResetIssue('012345', '😀'.repeat(8), '😀'.repeat(8)), null)
+  assert.equal(passwordResetIssue('012345', '😀'.repeat(4), '😀'.repeat(4)), 'acc.reset.passwordShort')
+  assert.equal(passwordResetIssue('012345', '1234567', '1234567'), 'acc.reset.passwordShort')
+  assert.equal(passwordResetIssue('012345', 'nueva clave', 'nueva clave '), 'acc.reset.passwordMismatch')
+  for (const code of ['12345', '1234567', 'abc123', '１２３４５６', ' 12345']) {
+    assert.equal(passwordResetIssue(code, 'Nueva clave', 'Nueva clave'), 'acc.reset.codeInvalid')
+  }
+})
+
+test('límite BCrypt72bytes se calcula en UTF8 con ASCII, tildes y emoji', () => {
+  for (const password of ['a'.repeat(72), 'á'.repeat(36), '😀'.repeat(18)]) {
+    assert.equal(passwordResetIssue('012345', password, password), null)
+  }
+  for (const password of ['a'.repeat(73), 'á'.repeat(37), '😀'.repeat(19)]) {
+    assert.equal(passwordResetIssue('012345', password, password), 'acc.reset.passwordLong')
+  }
+})
+
+test('errores visibles usan categorías genéricas traducibles, nunca textos de existencia de cuenta', () => {
+  for (const status of [400, 401, 403, 404]) assert.equal(passwordResetErrorKey(status, true), 'acc.reset.invalid')
+  assert.equal(passwordResetErrorKey(0, true), 'acc.reset.connectionError')
+  assert.equal(passwordResetErrorKey(429, true), 'acc.reset.rateLimit')
+  assert.equal(passwordResetErrorKey(400, false), 'acc.reset.emailInvalid')
+  assert.equal(passwordResetErrorKey(500, false), 'acc.reset.serviceError')
+})
+
+const linkFragment = (correo = 'recovery+qa@example.test', code = '012345') =>
+  '#password-reset?correo=' + encodeURIComponent(correo) + '&code=' + encodeURIComponent(code)
+
+test('parser admite exactamente correo y código6, conserva plus y cero inicial del enlace M8', () => {
+  assert.deepEqual(parsePasswordResetFragment(linkFragment()), { correo: 'recovery+qa@example.test', code: '012345' })
+  assert.deepEqual(parsePasswordResetFragment('#password-reset?code=012345&correo=recovery%2Bqa%40example.test'), { correo: 'recovery+qa@example.test', code: '012345' })
+})
+
+test('parser rechaza campos extra/duplicados, códigos inválidos, controles y encoding malformado', () => {
+  for (const fragment of [
+    '#other?correo=a%40example.test&code=012345',
+    '#password-reset',
+    linkFragment() + '&redirect=https%3A%2F%2Foutside.example',
+    '#password-reset?correo=a%40example.test&correo=b%40example.test',
+    '#password-reset?code=012345&code=654321',
+    '#password-reset?correo=a%40example.test&code=12345',
+    '#password-reset?correo=a%40example.test&code=1234567',
+    '#password-reset?correo=a%40example.test&code=１２３４５６',
+    '#password-reset?correo=missing-at&code=012345',
+    '#password-reset?correo=a%40b%40example.test&code=012345',
+    '#password-reset?correo=%20a%40example.test&code=012345',
+    '#password-reset?correo=a%00%40example.test&code=012345',
+    '#password-reset?correo=a%0D%0A%40example.test&code=012345',
+    '#password-reset?correo=%3Cscript%3E%40example.test&code=012345',
+    '#password-reset?correo=a%40example.test&code=%ZZ',
+    '#password-reset?correo=%C3%28%40example.test&code=012345',
+    linkFragment('a'.repeat(255) + '@example.test'),
+    linkFragment() + 'a'.repeat(2048),
+  ]) assert.equal(parsePasswordResetFragment(fragment), null)
+})
+
+function navigation(fragment) {
+  let hash = fragment
+  const calls = []
+  const location = { get hash() { return hash }, pathname: '/', search: '?view=access', replace: value => { calls.push(['replace', value]); hash = '' } }
+  const history = { replaceState: (state, title, value) => { calls.push(['replaceState', state, title, value]); hash = '' } }
+  return { location, history, calls }
+}
+
+test('consume enlace en memoria y borra fragmento sin incluir código/correo en history ni solicitudes', () => {
+  const page = navigation(linkFragment())
+  assert.deepEqual(consumePasswordResetFragment(page.location, page.history), { kind: 'link', correo: 'recovery+qa@example.test', code: '012345' })
+  assert.equal(page.location.hash, '')
+  assert.deepEqual(page.calls, [['replaceState', null, '', '/?view=access']])
+  assert.equal(consumePasswordResetFragment(page.location, page.history), null)
+  assert.equal(page.calls.length, 1)
+})
+
+test('enlaces reset inválidos también se limpian; otros fragmentos se conservan', () => {
+  const invalid = navigation(linkFragment() + '&extra=1')
+  assert.deepEqual(consumePasswordResetFragment(invalid.location, invalid.history), { kind: 'invalid' })
+  assert.equal(invalid.location.hash, '')
+  const other = navigation('#portfolio')
+  assert.equal(consumePasswordResetFragment(other.location, other.history), null)
+  assert.equal(other.location.hash, '#portfolio')
+  assert.deepEqual(other.calls, [])
+})
+
+test('si replaceState falla navega a URL limpia y no devuelve código para usarlo', () => {
+  const page = navigation(linkFragment())
+  page.history.replaceState = () => { throw new Error('History blocked') }
+  assert.deepEqual(consumePasswordResetFragment(page.location, page.history), { kind: 'invalid' })
+  assert.equal(page.location.hash, '')
+  assert.deepEqual(page.calls, [['replace', '/?view=access']])
+})
+
+test('sesión existente no autoriza recuperación; fallo la conserva y éxito la limpia sin logout ni autologin', async t => {
+  const key = 'acciones-ud.session.v1.https://gateway.test/api/v1'
+  const saved = { user: { id: 8, correo: 'previous@example.test' }, accessToken: 'fixture-old-access', refreshToken: 'fixture-old-refresh' }
+  const values = new Map([[key, JSON.stringify(saved)], [key + '.pending.8', JSON.stringify([['fixture-intent', 'fixture-key']])]])
+  const writes = []
+  const calls = []
+  let status = 401
+  t.mock.method(globalThis, 'fetch', async (url, options) => {
+    calls.push(new URL(url).pathname)
+    assert.equal(options.headers.has('Authorization'), false)
+    return Response.json(status === 200 ? { message: 'Actualizada' } : { error: 'Código inválido' }, { status })
+  })
+  const api = new Gateway('https://gateway.test/api/v1', {
+    getItem: item => values.get(item), setItem: (...args) => writes.push(args), removeItem: item => values.delete(item),
+  })
+  const page = navigation(linkFragment())
+  const link = consumePasswordResetFragment(page.location, page.history)
+  assert.equal(api.snapshot().user.id, 8)
+  assert.equal(calls.length, 0)
+  assert.deepEqual(writes, [])
+
+  await assert.rejects(api.confirmPasswordReset(link.correo, link.code, ' Nueva clave 123 '), error => error.status === 401)
+  assert.equal(api.snapshot().user.id, 8)
+  assert.equal(values.size, 2)
+  status = 200
+  await api.confirmPasswordReset(link.correo, link.code, ' Nueva clave 123 ')
+  assert.equal(api.snapshot(), null)
+  assert.equal(values.size, 0)
+  assert.deepEqual(writes, [])
+  assert.deepEqual(calls, ['/api/v1/auth/password-reset/confirm', '/api/v1/auth/password-reset/confirm'])
+  await assert.rejects(api.request('/users/me'), error => error.status === 401)
+  assert.equal(calls.length, 2)
+})
