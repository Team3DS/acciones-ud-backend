diff --git a/src/services/passwordReset.ts b/src/services/passwordReset.ts
new file mode 100644
index 0000000..cf8dfc9
--- /dev/null
+++ b/src/services/passwordReset.ts
@@ -0,0 +1,55 @@
+export interface PasswordResetLink { correo: string; code: string }
+export type PasswordResetEntry = ({ kind: 'link' } & PasswordResetLink) | { kind: 'invalid' }
+
+export function parsePasswordResetFragment(fragment: string): PasswordResetLink | null {
+  if (!fragment.startsWith('#password-reset?') || fragment.length > 2048) return null
+  const fields = fragment.slice('#password-reset?'.length).split('&')
+  if (fields.length !== 2) return null
+  const values = new Map<string, string>()
+  try {
+    for (const field of fields) {
+      const pair = field.split('=')
+      if (pair.length !== 2 || !['correo', 'code'].includes(pair[0]) || values.has(pair[0])) return null
+      values.set(pair[0], decodeURIComponent(pair[1]))
+    }
+  } catch { return null }
+  const correo = values.get('correo') ?? ''
+  const code = values.get('code') ?? ''
+  if (correo.length > 254 || !/^[^\s@<>\u0000-\u001f\u007f]+@[^\s@<>\u0000-\u001f\u007f]+$/u.test(correo)) return null
+  return /^[0-9]{6}$/.test(code) ? { correo, code } : null
+}
+
+export function consumePasswordResetFragment(
+  location: Pick<Location, 'hash' | 'pathname' | 'search' | 'replace'>,
+  history: Pick<History, 'replaceState'>,
+): PasswordResetEntry | null {
+  const fragment = location.hash
+  if (!fragment.startsWith('#password-reset')) return null
+  const clean = location.pathname + location.search
+  // Se borra antes de analizarlo y antes de montar cualquier pantalla.
+  try { history.replaceState(null, '', clean) }
+  catch {
+    // Si el navegador impide History API, elimina el fragmento con una navegación limpia.
+    try { location.replace(clean) } catch { /* No se utiliza el código si no se pudo limpiar la URL. */ }
+    return { kind: 'invalid' }
+  }
+  const link = parsePasswordResetFragment(fragment)
+  return link ? { kind: 'link', ...link } : { kind: 'invalid' }
+}
+
+export function passwordResetIssue(code: string, password: string, confirmation: string): string | null {
+  if (!/^[0-9]{6}$/.test(code)) return 'acc.reset.codeInvalid'
+  if (!password.trim()) return 'acc.reset.passwordBlank'
+  if ([...password].length < 8) return 'acc.reset.passwordShort'
+  if (new TextEncoder().encode(password).length > 72) return 'acc.reset.passwordLong'
+  if (password !== confirmation) return 'acc.reset.passwordMismatch'
+  return null
+}
+
+export function passwordResetErrorKey(status: number, confirming: boolean): string {
+  if (status === 0) return 'acc.reset.connectionError'
+  if (status === 429) return 'acc.reset.rateLimit'
+  if (confirming && [400, 401, 403, 404].includes(status)) return 'acc.reset.invalid'
+  if (!confirming && status === 400) return 'acc.reset.emailInvalid'
+  return 'acc.reset.serviceError'
+}
