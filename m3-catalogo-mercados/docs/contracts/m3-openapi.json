  "components": {
    "schemas": {
      "CrearInstrumentoCommand": {
        "required": [
          "lotSize",
          "market",
          "name",
          "sector",
          "symbol",
          "tickSize",
          "type"
        ],
        "type": "object",
        "properties": {
          "symbol": {
            "pattern": "[A-Za-z0-9][A-Za-z0-9.\\-]{0,19}",
            "type": "string"
          },
          "name": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "market": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "sector": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ACCION",
              "ETF",
              "OPCION",
              "FUTURO",
              "BONO",
              "CRYPTO"
            ]
          },
          "lotSize": {
            "minimum": 0,
            "exclusiveMinimum": true,
            "type": "number"
          },
          "tickSize": {
            "minimum": 0,
            "exclusiveMinimum": true,
            "type": "number"
          }
        }
      },
      "ValidarInstrumentosRequest": {
        "required": [
          "symbols"
        ],
        "type": "object",
        "properties": {
          "symbols": {
            "maxItems": 100,
            "minItems": 0,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "market": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "HorarioReferencia": {
        "type": "object",
        "properties": {
          "open": {
            "$ref": "#/components/schemas/LocalTime"
          },
          "close": {
            "$ref": "#/components/schemas/LocalTime"
          }
        }
      },
      "Instrumento": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "symbol": {
            "type": "string"
          },
          "companyName": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "market": {
            "$ref": "#/components/schemas/Mercado"
          },
          "sector": {
            "$ref": "#/components/schemas/Sector"
          },
          "type": {
            "type": "string",
            "enum": [
              "ACCION",
              "ETF",
              "OPCION",
              "FUTURO",
              "BONO",
              "CRYPTO"
            ]
          },
          "lotSize": {
            "type": "number"
          },
          "tickSize": {
            "type": "number"
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVO",
              "SUSPENDIDO",
              "RETIRADO"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LocalTime": {
        "type": "object",
        "properties": {
          "hour": {
            "type": "integer",
            "format": "int32"
          },
          "minute": {
            "type": "integer",
            "format": "int32"
          },
          "second": {
            "type": "integer",
            "format": "int32"
          },
          "nano": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Mercado": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mic": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "country": {
            "type": "string"
          },
          "tradingHours": {
            "$ref": "#/components/schemas/HorarioReferencia"
          }
        }
      },
      "Sector": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ValidacionInstrumento": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "HABILITADO",
              "NO_ENCONTRADO",
              "ACCION_DESHABILITADA",
              "MERCADO_DESHABILITADO",
              "SIMBOLO_AMBIGUO"
            ]
          },
          "instrument": {
            "$ref": "#/components/schemas/Instrumento"
          }
        }
      },
      "CrearMercadoCommand": {
        "required": [
          "mic",
          "name",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "code": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "mic": {
            "pattern": "[A-Za-z0-9]{4}",
            "type": "string"
          },
          "timeZone": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "currency": {
            "pattern": "USD",
            "type": "string"
          },
          "country": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "tradingHours": {
            "$ref": "#/components/schemas/HorarioReferencia"
          }
        }
      },
      "ActualizarInstrumentoCommand": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "lotSize": {
            "minimum": 0,
            "exclusiveMinimum": true,
            "type": "number"
          },
          "tickSize": {
            "minimum": 0,
            "exclusiveMinimum": true,
            "type": "number"
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVO",
              "SUSPENDIDO",
              "RETIRADO"
            ]
          }
        }
      },
      "ActualizarMercadoCommand": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "country": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "tradingHours": {
            "$ref": "#/components/schemas/HorarioReferencia"
          }
        }
      },
      "PaginaInstrumento": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Instrumento"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int64"
          },
          "empty": {
            "type": "boolean"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "first": {
            "type": "boolean"
          },
          "last": {
            "type": "boolean"
          },
          "numberOfElements": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
