---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Iniciar sesión | GLUD Fried Chicken">
	<main class="grid min-h-screen lg:grid-cols-[.9fr_1.1fr]">
		<section class="relative hidden overflow-hidden bg-gfc-red p-10 text-white lg:flex lg:flex-col lg:justify-between"><div class="absolute inset-0 manga-dash opacity-40"></div><div class="relative"><a href="/" class="flex items-center gap-3"><span class="grid h-12 w-12 rotate-[-8deg] place-items-center rounded-xl border-2 border-gfc-ink bg-white font-display text-xl font-bold text-gfc-red shadow-[4px_4px_0_#242125]">G</span><span class="font-display text-2xl font-bold">GLUD.</span></a></div><div class="relative"><p class="font-display text-7xl font-bold leading-[.9]">Vuelve por<br /><span class="text-gfc-yellow">el crunch.</span></p><p class="mt-6 max-w-sm text-lg font-bold text-white/80">Tu pedido favorito está a unos cuantos clics de distancia.</p></div><span class="relative rotate-[-5deg] self-start rounded-full border-2 border-gfc-ink bg-gfc-yellow px-5 py-2 font-display font-bold text-gfc-ink shadow-[4px_4px_0_#242125]">Pasa, hay pollo</span></section>
		<section class="flex items-center justify-center bg-gfc-cream p-5 sm:p-10"><div class="w-full max-w-md"><a href="/" class="mb-10 flex items-center gap-2 lg:hidden"><span class="grid h-11 w-11 rotate-[-8deg] place-items-center rounded-xl border-2 border-gfc-ink bg-gfc-red font-display text-xl font-bold text-white shadow-[3px_3px_0_#242125]">G</span><span class="font-display text-xl font-bold">GLUD<span class="text-gfc-red">.</span></span></a><div class="mb-8"><p class="font-display font-bold uppercase tracking-[.2em] text-gfc-red">Qué gusto verte</p><h1 class="mt-2 font-display text-5xl font-bold">Iniciar sesión</h1><p class="mt-3 font-semibold text-black/60">Entra con tu usuario o correo para continuar.</p></div><form id="login-form" class="space-y-5"><label class="block text-sm font-extrabold">Usuario o correo<input name="identificador" required autocomplete="username" class="mt-2 w-full rounded-xl border-2 border-gfc-ink bg-white px-4 py-3" /></label><label class="block text-sm font-extrabold">Contraseña<input name="contrasena" required minlength="6" type="password" autocomplete="current-password" class="mt-2 w-full rounded-xl border-2 border-gfc-ink bg-white px-4 py-3" /></label><p id="login-message" class="hidden rounded-xl bg-red-100 p-3 text-sm font-bold text-gfc-red-dark"></p><button class="paper w-full bg-gfc-red px-5 py-3 font-display text-lg font-bold text-white" type="submit">Entrar a GFC</button></form><p class="mt-7 text-center font-bold text-black/60">¿Primera vez por aquí? <a class="text-gfc-red underline" href="/registro">Crear una cuenta</a></p></div></section>
	</main>
</Layout>
<script>
	import { api, saveSession } from '../lib/api';
	const bajaMessage = document.querySelector('#login-message') as HTMLElement;
	if (new URLSearchParams(window.location.search).get('baja') === '1') { bajaMessage.textContent = 'Tu cuenta fue dada de baja. Si crees que es un error, contacta al equipo de soporte.'; bajaMessage.className = 'rounded-xl bg-green-100 p-3 text-sm font-bold text-green-800'; bajaMessage.classList.remove('hidden'); }
	document.querySelector('#login-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>; const message = document.querySelector('#login-message') as HTMLElement; message.classList.add('hidden'); try { const response = await api.login({ identificador: data.identificador, contrasena: data.contrasena }); saveSession(response); window.location.href = response.rol === 'EMPLEADO' ? '/dashboard' : '/'; } catch (error) { message.textContent = error instanceof Error ? error.message : 'No pudimos iniciar sesión. Revisa tus datos.'; message.classList.remove('hidden'); } });
</script>