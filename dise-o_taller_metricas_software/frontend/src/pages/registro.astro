---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Crear cuenta | GLUD Fried Chicken">
	<main class="min-h-screen bg-gfc-cream px-5 py-8 sm:py-12"><div class="mx-auto max-w-3xl"><div class="mb-8 flex items-center justify-between"><a href="/" class="flex items-center gap-2"><span class="grid h-11 w-11 rotate-[-8deg] place-items-center rounded-xl border-2 border-gfc-ink bg-gfc-red font-display text-xl font-bold text-white shadow-[3px_3px_0_#242125]">G</span><span class="font-display text-xl font-bold">GLUD<span class="text-gfc-red">.</span></span></a><a href="/login" class="font-bold text-gfc-red underline">Ya tengo cuenta</a></div><div class="paper bg-white p-6 sm:p-10"><div class="mb-8"><p class="font-display font-bold uppercase tracking-[.2em] text-gfc-red">Únete a la familia</p><h1 class="mt-2 font-display text-5xl font-bold">Crear cuenta</h1><p class="mt-3 font-semibold text-black/60">Guarda tus pedidos y vuelve por tu combo sin llenar todo de nuevo.</p></div><form id="register-form" class="grid gap-5 sm:grid-cols-2"><label class="flex items-center gap-3 rounded-xl border-2 border-gfc-ink bg-gfc-yellow/40 p-4 sm:col-span-2"><input id="is-company" type="checkbox" class="h-5 w-5 accent-gfc-red" /><span><strong class="block font-display text-lg">Es una cuenta de empresa</strong><small class="font-semibold text-black/60">Usaremos NIT y razón social para identificarla.</small></span></label><label class="block text-sm font-extrabold sm:col-span-2"><span id="name-label">Nombre completo</span><input name="nombre" required autocomplete="name" class="mt-2 w-full rounded-xl border-2 border-gfc-ink bg-gfc-cream px-4 py-3" /></label><label class="block text-sm font-extrabold"><span id="document-label">Tipo de documento</span><select id="document-type" name="tipoDocumento" required class="mt-2 w-full rounded-xl border-2 border-gfc-ink bg-gfc-cream px-4 py-3"><option value="CC">Cédula de ciudadanía</option><option value="TI">Tarjeta de identidad</option></select></label><label class="block text-sm font-extrabold"><span id="number-label">Número de documento</span><input name="numeroDocumento" required autocomplete="off" class="mt-2 w-full rounded-xl border-2 border-gfc-ink bg-gfc-cream px-4 py-3" /></label><label class="block text-sm font-extrabold">Usuario<input name="nombreUsuario" required autocomplete="username" class="mt-2 w-full rounded-xl border-2 border-gfc-ink bg-gfc-cream px-4 py-3" /></label><label class="block text-sm font-extrabold">Correo electrónico<input name="correo" required type="email" autocomplete="email" class="mt-2 w-full rounded-xl border-2 border-gfc-ink bg-gfc-cream px-4 py-3" /></label><label class="block text-sm font-extrabold">Contraseña<input name="contrasena" required minlength="6" type="password" autocomplete="new-password" class="mt-2 w-full rounded-xl border-2 border-gfc-ink bg-gfc-cream px-4 py-3" /></label><label class="block text-sm font-extrabold">Confirmar contraseña<input name="confirmarContrasena" required minlength="6" type="password" autocomplete="new-password" class="mt-2 w-full rounded-xl border-2 border-gfc-ink bg-gfc-cream px-4 py-3" /></label><p id="register-message" class="hidden rounded-xl p-3 text-sm font-bold sm:col-span-2"></p><button class="paper bg-gfc-red px-5 py-3 font-display text-lg font-bold text-white sm:col-span-2" type="submit">Crear mi cuenta</button></form></div></div></main>
</Layout>
<script>
	import { api, saveSession } from '../lib/api';
	const companyInput = document.querySelector('#is-company') as HTMLInputElement; const documentType = document.querySelector('#document-type') as HTMLSelectElement; const nameLabel = document.querySelector('#name-label') as HTMLElement; const numberLabel = document.querySelector('#number-label') as HTMLElement;
	companyInput.addEventListener('change', () => { const company = companyInput.checked; nameLabel.textContent = company ? 'Razón social' : 'Nombre completo'; numberLabel.textContent = company ? 'NIT' : 'Número de documento'; documentType.innerHTML = company ? '<option value="NIT">NIT</option>' : '<option value="CC">Cédula de ciudadanía</option><option value="TI">Tarjeta de identidad</option>'; });
	document.querySelector('#register-form')?.addEventListener('submit', async (event) => { event.preventDefault(); const form = event.currentTarget as HTMLFormElement; const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>; const message = document.querySelector('#register-message') as HTMLElement; message.className = 'hidden'; if (data.contrasena !== data.confirmarContrasena) { message.textContent = 'Las contraseñas no coinciden.'; message.className = 'rounded-xl bg-red-100 p-3 text-sm font-bold text-gfc-red-dark sm:col-span-2'; return; } try { const response = await api.register({ nombre: data.nombre, tipoDocumento: data.tipoDocumento, numeroDocumento: data.numeroDocumento, nombreUsuario: data.nombreUsuario, correo: data.correo, contrasena: data.contrasena }); saveSession(response); window.location.href = response.rol === 'EMPLEADO' ? '/dashboard' : '/'; } catch (error) { message.textContent = error instanceof Error ? error.message : 'No pudimos crear la cuenta. Revisa los datos.'; message.className = 'rounded-xl bg-red-100 p-3 text-sm font-bold text-gfc-red-dark sm:col-span-2'; } });
</script>