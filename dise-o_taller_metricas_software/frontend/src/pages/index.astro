---
import Layout from '../layouts/Layout.astro';
---
<Layout>
	<header class="sticky top-0 z-30 border-b-2 border-gfc-ink bg-gfc-cream/95 backdrop-blur-sm">
		<div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">
			<a href="/" class="flex items-center gap-2" aria-label="GLUD Fried Chicken, inicio"><span class="grid h-11 w-11 rotate-[-8deg] place-items-center rounded-xl border-2 border-gfc-ink bg-gfc-red font-display text-xl font-bold text-white shadow-[3px_3px_0_#242125]">G</span><span class="font-display text-xl font-bold tracking-tight">GLUD<span class="text-gfc-red">.</span></span></a>
			<nav class="hidden items-center gap-7 text-sm font-extrabold md:flex" aria-label="Navegación principal"><a class="hover:text-gfc-red" href="#menu">Menú</a><a class="hover:text-gfc-red" href="#por-que">Nuestra sazón</a><a id="nav-dashboard" class="hidden hover:text-gfc-red" href="/dashboard">Panel</a></nav>
			<div class="flex items-center gap-2"><div class="relative"><button id="auth-button" class="rounded-full px-3 py-2 text-sm font-extrabold hover:bg-white sm:px-4">Iniciar sesión</button><div id="account-menu" class="paper absolute right-0 top-12 z-40 hidden w-56 bg-white p-2"><a href="/perfil" class="block rounded-xl px-4 py-3 font-bold hover:bg-gfc-yellow">Mi perfil</a><a href="/perfil#pedidos" class="block rounded-xl px-4 py-3 font-bold hover:bg-gfc-yellow">Historial de pedidos</a><button id="logout-button" class="w-full rounded-xl px-4 py-3 text-left font-bold text-gfc-red hover:bg-red-50">Cerrar sesión</button></div></div><button id="cart-button" class="paper flex items-center gap-2 rounded-xl bg-gfc-yellow px-3 py-2 font-display font-bold" aria-label="Abrir carrito"><span aria-hidden="true">+</span><span id="cart-count">0</span></button></div>
		</div>
	</header>
	<main>
		<section class="relative isolate overflow-hidden bg-gfc-red text-white"><div class="absolute inset-0 manga-dash opacity-40"></div><div class="absolute right-[7%] top-12 rotate-12 font-display text-lg font-bold text-gfc-yellow">CRUNCH!</div><div class="absolute left-[5%] top-32 -rotate-12 font-display text-3xl text-gfc-yellow">✦</div><div class="relative mx-auto grid min-h-[590px] max-w-7xl items-center gap-12 px-5 py-16 lg:grid-cols-[1.05fr_.95fr] lg:px-8"><div class="pop-in max-w-2xl"><p class="mb-5 inline-block rotate-[-2deg] rounded-full border-2 border-gfc-ink bg-gfc-yellow px-4 py-2 font-display text-sm font-bold text-gfc-ink shadow-[4px_4px_0_#242125]">POLLO CON ACTITUD</p><h1 class="font-display text-6xl font-bold leading-[.93] tracking-tight sm:text-8xl">Crujiente<br /><span class="text-gfc-yellow">hasta el alma.</span></h1><p class="mt-7 max-w-lg text-lg font-bold leading-relaxed text-white/90">Recetas de barrio, sazón de otro nivel y ese crunch que suena antes de llegar a la mesa.</p><div class="mt-9 flex flex-wrap gap-4"><a href="#menu" class="paper-lift paper inline-flex items-center rounded-xl bg-white px-6 py-3 font-display text-lg font-bold text-gfc-red">Ver el menú <span class="ml-3">↓</span></a><button id="hero-auth" class="rounded-xl border-2 border-white px-6 py-3 font-bold text-white hover:bg-white hover:text-gfc-red">Tengo una cuenta</button></div></div><div class="relative mx-auto h-[330px] w-full max-w-[430px] sm:h-[410px]"><div class="absolute inset-x-8 bottom-4 h-24 rotate-[-5deg] rounded-[50%] bg-gfc-yellow/60"></div><div class="absolute left-[11%] top-10 h-52 w-52 rotate-[-9deg] rounded-[44%_56%_52%_48%] border-4 border-gfc-ink bg-[#f5a623] shadow-[9px_9px_0_#242125] sm:h-64 sm:w-64"></div><div class="absolute right-[8%] top-20 h-44 w-44 rotate-[12deg] rounded-[52%_48%_45%_55%] border-4 border-gfc-ink bg-[#d97818] shadow-[8px_8px_0_#242125] sm:h-56 sm:w-56"></div><div class="absolute left-[35%] top-2 z-10 grid h-32 w-32 rotate-[8deg] place-items-center rounded-[48%] border-4 border-gfc-ink bg-white font-display text-3xl font-bold text-gfc-red shadow-[7px_7px_0_#242125] sm:h-40 sm:w-40">GFC<br /><span class="text-base text-gfc-ink">FRIED</span></div><div class="absolute bottom-4 left-4 rotate-[-13deg] font-display text-5xl font-bold text-white">YUM!</div></div></div></section>
		<section id="menu" class="mx-auto max-w-7xl px-5 py-20 lg:px-8"><div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="font-display font-bold uppercase tracking-[.2em] text-gfc-red">Para compartir o no</p><h2 class="mt-2 font-display text-4xl font-bold sm:text-5xl">Elige tu combo</h2></div><span class="sticker rotate-2 bg-white px-4 py-2 font-bold">Hecho al momento</span></div><div id="menu-status" class="paper flex min-h-48 items-center justify-center bg-white p-8 text-center font-bold" aria-live="polite"><div class="flex items-center gap-3"><span class="h-5 w-5 animate-spin rounded-full border-4 border-gfc-red border-t-transparent"></span>Cargando el menú...</div></div><div id="menu-grid" class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3"></div></section>
		<section id="por-que" class="border-y-2 border-gfc-ink bg-gfc-yellow py-16"><div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[.8fr_1.2fr] lg:px-8"><div><p class="font-display font-bold uppercase tracking-[.2em] text-gfc-red">La fórmula GFC</p><h2 class="mt-2 font-display text-4xl font-bold">Papel, fuego<br />y buen diente.</h2></div><div class="grid gap-5 sm:grid-cols-3"><div class="paper-lift paper rotate-[-2deg] bg-white p-5"><strong class="font-display text-3xl text-gfc-red">01</strong><h3 class="mt-5 font-display text-xl font-bold">Sazón real</h3><p class="mt-2 text-sm font-semibold leading-relaxed">Cada pieza recibe su mezcla antes de entrar al fuego.</p></div><div class="paper-lift paper rotate-[2deg] bg-white p-5"><strong class="font-display text-3xl text-gfc-red">02</strong><h3 class="mt-5 font-display text-xl font-bold">Crunch serio</h3><p class="mt-2 text-sm font-semibold leading-relaxed">Doradito, jugoso y con ese sonido que buscas.</p></div><div class="paper-lift paper rotate-[-1deg] bg-white p-5"><strong class="font-display text-3xl text-gfc-red">03</strong><h3 class="mt-5 font-display text-xl font-bold">Sin drama</h3><p class="mt-2 text-sm font-semibold leading-relaxed">Pide fácil, personaliza y recibe el total claro.</p></div></div></div></section>
	</main>
	<footer class="bg-gfc-ink px-5 py-8 text-white"><div class="mx-auto flex max-w-7xl flex-col justify-between gap-3 sm:flex-row sm:items-center lg:px-3"><p class="font-display text-xl font-bold">GLUD<span class="text-gfc-yellow">.</span></p><p class="text-sm font-bold text-white/60">Sabor local. Energía global. Bogotá, Colombia.</p></div></footer>
	<div id="detail-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-gfc-ink/70 p-4" role="dialog" aria-modal="true" aria-labelledby="detail-title"><div class="paper max-h-[90vh] w-full max-w-lg overflow-y-auto bg-gfc-cream p-6 sm:p-8"><div class="flex items-start justify-between gap-4"><div><p class="font-display font-bold uppercase tracking-widest text-gfc-red">Personaliza tu pedido</p><h2 id="detail-title" class="mt-1 font-display text-3xl font-bold"></h2></div><button class="close-modal rounded-full border-2 border-gfc-ink px-3 py-1 font-bold" aria-label="Cerrar detalle">×</button></div><div id="detail-content" class="mt-6"></div></div></div>
	<aside id="cart-drawer" class="fixed right-0 top-0 z-50 flex h-full w-full max-w-md translate-x-full flex-col border-l-2 border-gfc-ink bg-gfc-cream p-6 shadow-[-8px_0_0_rgba(36,33,37,.25)] transition-transform" aria-label="Carrito de compras"><div class="flex items-center justify-between"><h2 class="font-display text-3xl font-bold">Tu pedido</h2><button id="close-cart" class="rounded-full border-2 border-gfc-ink px-3 py-1 font-bold" aria-label="Cerrar carrito">×</button></div><div id="cart-items" class="flex-1 overflow-y-auto py-6"><p class="text-center font-bold text-black/60">Tu canasta está esperando algo crujiente.</p></div><div class="border-t-2 border-gfc-ink pt-5"><div class="flex justify-between font-display text-xl font-bold"><span>Total</span><span id="cart-total">$0</span></div><button id="checkout-button" class="paper mt-5 w-full bg-gfc-red px-5 py-3 font-display text-lg font-bold text-white">Pagar pedido</button><p id="checkout-message" class="mt-3 hidden rounded-lg p-3 text-sm font-bold"></p></div></aside><div id="cart-backdrop" class="fixed inset-0 z-40 hidden bg-gfc-ink/40"></div>
<script>
import { api, getSession, type Comida, type ComidaDetalle, type Configuracion } from '../lib/api';
type CartItem = { comida: Comida; cantidad: number; personalizaciones: Array<{ configuracionId: number; tipoAdicion: 'ADICIONAL' | 'RETIRADO'; cantidad: number }>; extras: number };
const menuGrid = document.querySelector('#menu-grid') as HTMLElement; const menuStatus = document.querySelector('#menu-status') as HTMLElement; const detailModal = document.querySelector('#detail-modal') as HTMLElement; const cartDrawer = document.querySelector('#cart-drawer') as HTMLElement; const cartBackdrop = document.querySelector('#cart-backdrop') as HTMLElement; const accountMenu = document.querySelector('#account-menu') as HTMLElement; let cart: CartItem[] = JSON.parse(localStorage.getItem('gfc_cart') || '[]') as CartItem[];
const money = (value: number) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(value); const dishArt = (index: number) => ['bg-[#f5a623] rotate-[-8deg]', 'bg-[#d97818] rotate-[7deg]', 'bg-[#e60012] rotate-[-4deg]', 'bg-[#f4c232] rotate-[5deg]'][index % 4];
function renderMenu(items: Comida[]) { menuStatus.classList.add('hidden'); menuGrid.innerHTML = items.map((item, index) => `<button class="paper-lift paper group flex flex-col bg-white p-4 text-left" data-comida="${item.id}"><div class="relative grid h-52 place-items-center overflow-hidden rounded-xl bg-[#fff1dd]"><span class="absolute right-3 top-3 font-display text-2xl text-gfc-red">✦</span>${item.imagenURL ? `<img src="${item.imagenURL}" alt="${item.nombre}" width="320" height="208" loading="lazy" class="h-full w-full object-cover" />` : `<span class="grid h-32 w-32 place-items-center rounded-[48%] border-2 border-gfc-ink ${dishArt(index)} font-display text-center font-bold text-white shadow-[5px_5px_0_#242125]">GFC<br />CRUNCH</span>`}</div><div class="flex items-end justify-between gap-3 pt-5"><div><span class="text-xs font-extrabold uppercase tracking-widest text-gfc-red">Favorito de la casa</span><h3 class="mt-1 font-display text-2xl font-bold group-hover:text-gfc-red">${item.nombre}</h3></div><span class="font-display text-lg font-bold">${money(Number(item.precio))}</span></div><span class="mt-4 text-sm font-extrabold text-gfc-red">Ver detalle →</span></button>`).join(''); menuGrid.querySelectorAll<HTMLElement>('[data-comida]').forEach((card) => card.addEventListener('click', () => openDetail(Number(card.dataset.comida)))); }
async function loadMenu() { try { const items = await api.getComidas(); if (!items.length) throw new Error('Todavía no hay platos publicados.'); renderMenu(items); } catch (error) { menuStatus.innerHTML = `<div><p class="font-display text-xl font-bold">No pudimos traer el menú.</p><p class="mt-2 text-sm text-black/60">${error instanceof Error ? error.message : 'Revisa que el backend esté encendido.'}</p><button id="retry-menu" class="paper mt-5 bg-gfc-yellow px-5 py-2 font-bold">Intentar de nuevo</button></div>`; document.querySelector('#retry-menu')?.addEventListener('click', loadMenu); } }
function openDetail(id: number) { detailModal.classList.remove('hidden'); detailModal.classList.add('flex'); const content = document.querySelector('#detail-content') as HTMLElement; content.innerHTML = '<p class="font-bold">Preparando el detalle...</p>'; api.getComida(id).then((item: ComidaDetalle) => { (document.querySelector('#detail-title') as HTMLElement).textContent = item.nombre; content.innerHTML = `<p class="text-2xl font-display font-bold text-gfc-red">${money(Number(item.precio))}</p><p class="mt-2 font-semibold">Personaliza tu pedido: agrega algo extra o quita lo que no quieras. Los ingredientes base no se pueden retirar.</p><div class="mt-6 space-y-3">${item.ingredientes?.map((config: Configuracion) => { const checked = config.incluidoPorDefecto; const disabled = config.incluidoPorDefecto ? !config.permiteRetirar : !config.permiteAdicional; const label = config.incluidoPorDefecto ? (config.permiteRetirar ? 'Quitar' : 'Base obligatoria') : (config.permiteAdicional ? 'Agregar' : 'No disponible'); return `<label class="flex items-center justify-between gap-3 rounded-xl border-2 border-gfc-ink bg-white p-3 text-sm font-bold"><span><input type="checkbox" class="mr-2 h-4 w-4 accent-gfc-red" data-extra="${config.id}" data-incluido="${config.incluidoPorDefecto}" data-precio="${config.precioAdicional}" data-cantidad-base="${config.cantidadBase}" ${checked ? 'checked' : ''} ${disabled ? 'disabled' : ''} />${label} ${config.ingrediente.nombreIngrediente}</span><span>${disabled && config.incluidoPorDefecto ? 'Esencial' : config.incluidoPorDefecto ? 'Incluido' : config.permiteAdicional ? `+${money(Number(config.precioAdicional))}` : '—'}</span></label>`; }).join('') || '<p class="rounded-xl bg-white p-4 font-bold">La receta viene lista para disfrutar.</p>'}</div><div class="mt-7 flex items-center gap-3"><label class="font-bold">Cantidad<input id="detail-quantity" type="number" min="1" value="1" class="ml-2 w-20 rounded-lg border-2 border-gfc-ink bg-white p-2 text-center" /></label><button id="add-to-cart" class="paper flex-1 bg-gfc-red px-4 py-3 font-display font-bold text-white">Añadir al carrito</button></div>`; content.querySelector('#add-to-cart')?.addEventListener('click', () => { const quantity = Number((content.querySelector('#detail-quantity') as HTMLInputElement).value); const inputs = content.querySelectorAll<HTMLInputElement>('[data-extra]'); const personalizaciones: Array<{ configuracionId: number; tipoAdicion: 'ADICIONAL' | 'RETIRADO'; cantidad: number }> = []; let extras = 0; inputs.forEach((input) => { const configId = Number(input.dataset.extra); const incluidoPorDefecto = input.dataset.incluido === 'true'; const checked = input.checked; if (!incluidoPorDefecto && checked) { const precio = Number(input.dataset.precio || 0); personalizaciones.push({ configuracionId: configId, tipoAdicion: 'ADICIONAL', cantidad: 1 }); extras += precio; } else if (incluidoPorDefecto && !checked) { const cantidadBase = Number(input.dataset.cantidadBase || 1); personalizaciones.push({ configuracionId: configId, tipoAdicion: 'RETIRADO', cantidad: cantidadBase }); } }); const existing = cart.find((cartItem) => cartItem.comida.id === item.id); if (existing) existing.cantidad += quantity; else cart.push({ comida: item, cantidad: quantity, personalizaciones, extras }); persistCart(); closeDetail(); openCart(); }); }).catch((error) => { content.innerHTML = `<p class="font-bold text-gfc-red-dark">${error instanceof Error ? error.message : 'No pudimos cargar este plato.'}</p>`; }); }
function persistCart() { localStorage.setItem('gfc_cart', JSON.stringify(cart)); renderCart(); } function renderCart() { const count = cart.reduce((sum, item) => sum + item.cantidad, 0); (document.querySelector('#cart-count') as HTMLElement).textContent = String(count); const total = cart.reduce((sum, item) => sum + (Number(item.comida.precio) + item.extras) * item.cantidad, 0); (document.querySelector('#cart-total') as HTMLElement).textContent = money(total); const container = document.querySelector('#cart-items') as HTMLElement; container.innerHTML = cart.length ? cart.map((item, index) => `<div class="flex items-center justify-between gap-3 border-b border-gfc-ink/20 py-4"><div><p class="font-display font-bold">${item.comida.nombre}</p><p class="text-sm font-bold text-gfc-red">${money(Number(item.comida.precio) + item.extras)}</p></div><div class="flex items-center gap-2"><button class="qty-minus h-8 w-8 rounded-lg border-2 border-gfc-ink font-bold" data-index="${index}" aria-label="Reducir cantidad">−</button><span class="w-5 text-center font-bold">${item.cantidad}</span><button class="qty-plus h-8 w-8 rounded-lg border-2 border-gfc-ink font-bold" data-index="${index}" aria-label="Aumentar cantidad">+</button></div></div>`).join('') : '<p class="text-center font-bold text-black/60">Tu canasta está esperando algo crujiente.</p>'; container.querySelectorAll<HTMLButtonElement>('.qty-minus').forEach((button) => button.addEventListener('click', () => changeQuantity(Number(button.dataset.index), -1))); container.querySelectorAll<HTMLButtonElement>('.qty-plus').forEach((button) => button.addEventListener('click', () => changeQuantity(Number(button.dataset.index), 1))); } function changeQuantity(index: number, amount: number) { cart[index].cantidad += amount; if (cart[index].cantidad < 1) cart.splice(index, 1); persistCart(); }
function openCart() { cartDrawer.classList.remove('translate-x-full'); cartBackdrop.classList.remove('hidden'); } function closeCart() { cartDrawer.classList.add('translate-x-full'); cartBackdrop.classList.add('hidden'); } function closeDetail() { detailModal.classList.add('hidden'); detailModal.classList.remove('flex'); }
document.querySelector('#cart-button')?.addEventListener('click', openCart); document.querySelector('#close-cart')?.addEventListener('click', closeCart); cartBackdrop.addEventListener('click', closeCart); document.querySelectorAll('.close-modal').forEach((button) => button.addEventListener('click', closeDetail)); document.querySelector('#auth-button')?.addEventListener('click', () => { const session = getSession(); if (session) accountMenu.classList.toggle('hidden'); else window.location.href = '/login'; }); document.querySelector('#logout-button')?.addEventListener('click', () => { localStorage.removeItem('gfc_token'); localStorage.removeItem('gfc_role'); localStorage.removeItem('gfc_user'); window.location.reload(); }); document.querySelector('#hero-auth')?.addEventListener('click', () => { window.location.href = '/login'; });
document.querySelector('#checkout-button')?.addEventListener('click', async () => { const message = document.querySelector('#checkout-message') as HTMLElement; const session = getSession(); if (!session) { closeCart(); window.location.href = '/login'; return; } if (!cart.length) { message.textContent = 'Agrega al menos una comida para continuar.'; message.className = 'mt-3 rounded-lg bg-yellow-100 p-3 text-sm font-bold'; return; } try { const result = await api.createOrder({ detalles: cart.map((item) => ({ comidaId: item.comida.id, cantidad: item.cantidad, personalizaciones: item.personalizaciones })) }); message.textContent = `Pedido confirmado. Total: ${money(Number(result.valorTotal ?? result.total ?? 0))}`; message.className = 'mt-3 rounded-lg bg-green-100 p-3 text-sm font-bold text-green-800'; cart = []; persistCart(); } catch (error) { message.textContent = error instanceof Error ? error.message : 'No pudimos crear el pedido. Revisa el stock disponible.'; message.className = 'mt-3 rounded-lg bg-red-100 p-3 text-sm font-bold text-gfc-red-dark'; } });
const session = getSession(); if (session) { (document.querySelector('#auth-button') as HTMLElement).textContent = `Hola, ${session.nombreUsuario}`; if (session.rol === 'EMPLEADO') (document.querySelector('#nav-dashboard') as HTMLElement).classList.remove('hidden'); } loadMenu(); renderCart();
</script>
<script>
	const customizationObserver = new MutationObserver(() => {
		document.querySelectorAll<HTMLInputElement>('#detail-content [data-extra]').forEach((input) => { input.checked = false; });
	});
	customizationObserver.observe(document.querySelector('#detail-content') as HTMLElement, { childList: true, subtree: true });
</script>
</Layout>
