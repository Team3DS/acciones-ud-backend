---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Mi perfil | GLUD Fried Chicken">
	<header class="border-b-2 border-gfc-ink bg-gfc-cream"><div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4"><a href="/" class="flex items-center gap-2"><span class="grid h-11 w-11 rotate-[-8deg] place-items-center rounded-xl border-2 border-gfc-ink bg-gfc-red font-display text-xl font-bold text-white shadow-[3px_3px_0_#242125]">G</span><span class="font-display text-xl font-bold">GLUD<span class="text-gfc-red">.</span></span></a><button id="logout" class="rounded-xl border-2 border-gfc-ink px-4 py-2 font-bold text-gfc-red hover:bg-gfc-yellow">Cerrar sesión</button></div></header>
	<main class="mx-auto max-w-6xl px-5 py-10"><div class="mb-10"><p class="font-display font-bold uppercase tracking-[.2em] text-gfc-red">Tu esquina GFC</p><h1 class="mt-2 font-display text-5xl font-bold">Mi perfil</h1></div><section class="grid gap-6 lg:grid-cols-[.7fr_1.3fr]"><div class="paper bg-gfc-yellow p-6 sm:p-8"><div class="grid h-16 w-16 place-items-center rounded-2xl border-2 border-gfc-ink bg-white font-display text-3xl font-bold text-gfc-red shadow-[4px_4px_0_#242125]" id="avatar">G</div><h2 id="profile-name" class="mt-6 font-display text-3xl font-bold">Cargando...</h2><p id="profile-email" class="mt-1 font-semibold text-black/60"></p><dl class="mt-8 space-y-4 border-t-2 border-gfc-ink/20 pt-5 text-sm"><div class="flex justify-between gap-4"><dt class="font-bold">Usuario</dt><dd id="profile-user"></dd></div><div class="flex justify-between gap-4"><dt class="font-bold">Documento</dt><dd id="profile-document"></dd></div></dl></div><div id="pedidos" class="paper bg-white p-6 sm:p-8"><div class="flex items-end justify-between gap-4"><div><p class="font-display font-bold uppercase tracking-[.2em] text-gfc-red">Lo que ya disfrutaste</p><h2 class="mt-2 font-display text-3xl font-bold">Historial de pedidos</h2></div><a href="/#menu" class="rounded-xl border-2 border-gfc-ink px-4 py-2 text-sm font-bold hover:bg-gfc-yellow">Pedir de nuevo</a></div><div id="orders-status" class="mt-8 rounded-xl bg-gfc-cream p-6 text-center font-bold">Cargando tus pedidos...</div><div id="orders-list" class="mt-6 space-y-5"></div></div>		</section>
		<section class="mt-8"><div class="paper border-gfc-red bg-white p-6 sm:p-8"><div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><p class="font-display font-bold uppercase tracking-[.2em] text-gfc-red">Zona de peligro</p><h2 class="mt-2 font-display text-3xl font-bold">Eliminar mi cuenta</h2><p class="mt-2 max-w-lg text-sm font-semibold text-black/60">Tu cuenta sera desactivada y no podras iniciar sesion de nuevo. Tus pedidos se conservan como historial.</p></div><button id="baja-button" class="rounded-xl border-2 border-gfc-ink bg-gfc-red px-5 py-3 font-display text-lg font-bold text-white hover:bg-gfc-red-dark whitespace-nowrap">Darme de baja</button></div><p id="baja-message" class="mt-4 hidden rounded-lg p-3 text-sm font-bold"></p></div></section></main>
</Layout>
<script>
import { api, clearSession, getSession, type PedidoResumen } from '../lib/api';
const session = getSession();
if (!session) window.location.href = '/login';
const money = (value: number) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(value);
const date = (value: string) => new Intl.DateTimeFormat('es-CO', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
function renderProfile() { if (!session) return; const name = session.nombre || session.nombreUsuario; (document.querySelector('#profile-name') as HTMLElement).textContent = name || 'Cliente GFC'; (document.querySelector('#profile-email') as HTMLElement).textContent = session.email || 'Cliente'; (document.querySelector('#profile-user') as HTMLElement).textContent = session.nombreUsuario; (document.querySelector('#profile-document') as HTMLElement).textContent = session.documento || 'No registrado'; (document.querySelector('#avatar') as HTMLElement).textContent = (name || 'G').slice(0, 1).toUpperCase(); }
function renderOrders(orders: PedidoResumen[]) { const status = document.querySelector('#orders-status') as HTMLElement; const list = document.querySelector('#orders-list') as HTMLElement; if (!orders.length) { status.textContent = 'Todavía no tienes pedidos. El menú está listo para cuando quieras volver.'; return; } status.classList.add('hidden'); list.innerHTML = orders.map((order) => `<article class="rounded-2xl border-2 border-gfc-ink bg-gfc-cream p-5"><div class="flex flex-wrap items-start justify-between gap-3 border-b-2 border-gfc-ink/15 pb-4"><div><p class="font-display text-xl font-bold">Pedido #${order.id}</p><p class="text-sm font-bold text-black/55">${date(order.fecha)}</p></div><strong class="font-display text-2xl text-gfc-red">${money(Number(order.valorTotal))}</strong></div><div class="mt-4 space-y-4">${order.detalle.map((detail) => `<div><div class="flex justify-between gap-3 font-bold"><span>${detail.cantidad} x ${detail.comida}</span><span>${money(Number(detail.subtotal))}</span></div>${detail.personalizaciones?.length ? `<ul class="mt-2 space-y-1 pl-4 text-sm font-semibold text-black/65">${detail.personalizaciones.map((option) => `<li>${option.tipoAdicion === 'RETIRADO' ? 'Sin' : 'Extra'} ${option.ingrediente}${option.cantidad > 1 ? ` x${option.cantidad}` : ''}${option.tipoAdicion === 'ADICIONAL' && Number(option.costoAdicional) > 0 ? ` (+${money(Number(option.costoAdicional))})` : ''}</li>`).join('')}</ul>` : ''}</div>`).join('')}</div></article>`).join(''); }
async function loadOrders() { try { renderOrders(await api.getMyOrders()); } catch (error) { const status = document.querySelector('#orders-status') as HTMLElement; status.textContent = error instanceof Error ? error.message : 'No pudimos cargar tu historial.'; status.className = 'mt-8 rounded-xl bg-red-100 p-6 text-center font-bold text-gfc-red-dark'; } }
document.querySelector('#logout')?.addEventListener('click', () => { clearSession(); window.location.href = '/'; }); document.querySelector('#baja-button')?.addEventListener('click', async () => { const msg = document.querySelector('#baja-message') as HTMLElement; const confirmed = confirm('Tu cuenta sera desactivada y no podras iniciar sesion de nuevo. Tus pedidos se conservan como historial.\n\nEsta accion no se puede deshacer. ¿Continuar?'); if (!confirmed) return; try { await api.darseDeBaja(); clearSession(); window.location.href = '/login?baja=1'; } catch (error) { msg.textContent = error instanceof Error ? error.message : 'No se pudo completar la baja. Intenta de nuevo.'; msg.className = 'rounded-lg bg-red-100 p-3 text-sm font-bold text-gfc-red-dark'; msg.classList.remove('hidden'); } }); renderProfile(); loadOrders();
</script>
