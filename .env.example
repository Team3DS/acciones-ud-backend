# Variables para docker compose. Copiar a .env (ignorado por Git) y completar; no subir nunca el .env.
# Generar los secretos una sola vez y conservarlos: si cambian, se invalidan sesiones y datos cifrados.

# --- Servidor (docker-compose.prod.yml) ---
# Dominio público; Caddy pide el certificado HTTPS para él.
DOMINIO=accionesud.dpdns.org
# Carpeta del repositorio del frontend, relativa a esta.
FRONTEND_DIR=../acciones-ud-frontend

# --- Infraestructura (cambiar en el servidor antes del primer arranque) ---
DB_USER=acciones_ud
DB_PASSWORD=cambiar-esta-clave
RABBITMQ_USER=acciones_ud
RABBITMQ_PASSWORD=cambiar-esta-clave

# --- Seguridad (obligatorias) ---
# Secreto compartido de los JWT: M1 firma y el resto valida. Mínimo 32 caracteres.
#   openssl rand -hex 32
JWT_SECRET=
# Clave AES de M1 para datos personales: 32 bytes en Base64.
#   openssl rand -base64 32
CIFRADO_KEY=
# Clave AES de M8 para los correos pendientes: 32 bytes en Base64.
#   openssl rand -base64 32
M8_MAIL_KEY=

# --- Alpaca (paper trading) ---
# Sin claves, M4 no obtiene cotizaciones y M5 ejecuta las órdenes con el simulador.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# --- Correo (M8, Resend) ---
# El remitente debe ser de un dominio verificado en Resend.
RESEND_API_KEY=
RESEND_FROM=Acciones UD <noreply@accionesud.com>

# --- Pagos (M10, Stripe en modo prueba) ---
STRIPE_API_KEY=
# Webhook en Stripe: https://<dominio>/api/v1/payments/webhook/stripe
STRIPE_WEBHOOK_SECRET=
# Dirección del frontend a la que Stripe regresa después del pago (en el servidor se toma de DOMINIO).
FRONTEND_URL=http://127.0.0.1:5173

# --- Opcionales ---
# Token compartido para las consultas internas M8 -> M10. Necesario para comprobar Premium en las alertas.
# Compose lo entrega a M8 como M8_SERVICE_TOKEN y a M10 como M10_INTERNAL_TOKEN.
#   openssl rand -hex 32
# Las llamadas de M8 a M1/M3/M4 usan JWT cortos firmados automáticamente con JWT_SECRET.
M8_SERVICE_TOKEN=
M8_MONTHLY_ENABLED=false
